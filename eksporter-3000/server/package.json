{
  "name": "eksporter-3000-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tymczasowy eksporter danych statycznych z Hotres do bazy Prisma (SQLite)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "export": "tsx src/cli.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset",
    "generate": "prisma generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "archiver": "^8.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "prisma": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "~5.8.2",
    "vitest": "^2.1.9"
  }
}
